# Скопируй в .env и заполни. Файл .env в git не попадает.
# На GitHub эти же имена заводятся в Settings → Secrets and variables → Actions.

# Какой генератор пишет тексты:
#   gigachat  — GigaChat от Сбера, работает в России (по умолчанию)
#   gemini    — Google Gemini 2.5 Pro, бесплатно, но в России недоступен
#   anthropic — Anthropic Claude, платно, в России недоступен
LLM_PROVIDER=gigachat

# GigaChat: «Ключ авторизации» из проекта на developers.sber.ru
# (GigaChat API → создать проект для физических лиц)
GIGACHAT_CREDENTIALS=

# Модель: GigaChat, GigaChat-Pro или GigaChat-Max
GIGACHAT_MODEL=GigaChat-Pro

# Google AI Studio: бесплатный ключ — aistudio.google.com/apikey (не для России)
GOOGLE_API_KEY=

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал: @username канала (например @plenka_fm) или числовой id (-100...)
TELEGRAM_CHANNEL_ID=

# Твой личный user id — сюда идут алерты и превью постов (узнать у @userinfobot).
# Нужно именно число, не @username.
TELEGRAM_ADMIN_ID=

# Last.fm: бесплатный ключ с last.fm/api/account/create
LASTFM_API_KEY=

# Anthropic: нужен, только если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ВКонтакте (этап 3, пока можно оставить пустым)
VK_TOKEN=
VK_GROUP_ID=
