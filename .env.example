# Скопируй в .env и заполни. Файл .env в git не попадает.
# На GitHub эти же имена заводятся в Settings → Secrets and variables → Actions.

# Какой генератор пишет тексты:
#   anthropic — Anthropic Claude, платно, пишет лучше всех (по умолчанию)
#   gigachat  — GigaChat от Сбера, работает в России
#   gemini    — Google Gemini 2.5 Pro, бесплатно, но в России недоступен
LLM_PROVIDER=anthropic

# Запасной генератор: включается сам, если основной не ответил — кончились
# деньги, отвалилась сеть, упал сервис. Пусто — фоллбека нет, запуск падает.
LLM_FALLBACK=gigachat

# GigaChat: «Ключ авторизации» из проекта на developers.sber.ru
# (GigaChat API → создать проект для физических лиц)
GIGACHAT_CREDENTIALS=

# Модель: GigaChat, GigaChat-Pro или GigaChat-Max
GIGACHAT_MODEL=GigaChat-Pro

# Google AI Studio: бесплатный ключ — aistudio.google.com/apikey (не для России)
GOOGLE_API_KEY=

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал: @username канала (например @plenka_fm) или числовой id (-100...)
TELEGRAM_CHANNEL_ID=

# Твой личный user id — сюда идут алерты и превью постов (узнать у @userinfobot).
# Нужно именно число, не @username.
TELEGRAM_ADMIN_ID=

# Last.fm: бесплатный ключ с last.fm/api/account/create
LASTFM_API_KEY=

# Anthropic: нужен, только если LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Видеоряд для клипов: pixabay.com → профиль → Настройки → API.
# Бесплатно и без лимита по деньгам. Без ключа клипы соберутся на
# нарисованном фоне — работать будут, но выглядеть скромнее.
# PEXELS_API_KEY — альтернатива, берётся первый непустой из двух.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Голос ведущей в клипах: Fish Audio (fish.audio → API Keys). Взят ради
# слепка голоса: у персонажа голос должен быть свой и один навсегда,
# стоковым диктором говорит десяток других каналов.
# Пусто — ролики соберутся молча, расписание из-за этого не встанет.
FISH_AUDIO_KEY=

# Где лежит своя сборка kokoro-ru — локальный синтез голоса Крис. Это основной
# путь: бесплатно, без сети и без чужого баланса. Модель весит триста мегабайт
# и в репозиторий не кладётся, поэтому путь задаётся здесь.
# По умолчанию ~/claude-voice-ru, в Actions её нет и голос берёт Fish.
KOKORO_RU_DIR=

# SerpAPI: активный поиск в Google/Google News/Яндексе через посредника —
# вместо пассивного ожидания новостей в RSS-лентах. serpapi.com → Manage API Key.
# Кодом пока не используется, ключ можно положить заранее.
SERPAPI_API_KEY=

# ВКонтакте (этап 3, пока можно оставить пустым)
VK_TOKEN=
VK_GROUP_ID=

# Плейлист сообщества: адрес из строки браузера целиком, вместе с ключом
# доступа после второго подчёркивания. Пусто — посты уходят без музыки.
# Пополняется только руками: раздел audio.* для сообществ ВКонтакте закрыт.
VK_PLAYLIST=
