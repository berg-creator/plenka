.env
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
*.egg-info/

# Локальные черновики и выгрузки, которые не должны попадать в репозиторий
scratch/
*.local.json

# Карточки разборов — временные файлы: уходят человеку и удаляются
assets/cards/

# Готовые ролики: по несколько мегабайт каждый, пересобираются из lineage.json
# в любой момент.
assets/clips/

# Подложки клипов. Лицензия Pixabay запрещает раздавать треки отдельными
# файлами, а открытый репозиторий — это ровно такая раздача. Треки лежат
# только на диске; откуда каждый — в assets/audio/SOURCES.md.
assets/audio/*.mp3
assets/audio/*.wav

# Данные о людях: списки слежения. В открытый репозиторий не попадают
# никогда — в Actions сюда клонируется приватный репозиторий.
data/private/
